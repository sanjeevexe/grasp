#!/usr/bin/env node
const fs = require("fs");

const args = process.argv.slice(2);
if (process.env.GRASP_QA_LOG) {
  fs.appendFileSync(process.env.GRASP_QA_LOG, JSON.stringify(args) + "\n");
}

const mode = process.env.GRASP_QA_MODE || "normal";
if (mode === "exit-error") {
  process.stderr.write("deliberate mock failure\n");
  process.exit(7);
}
if (mode === "hang") {
  Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, 30000);
}
if (mode === "decline") {
  const result = { worthAsking: false, conceptTag: null, questionConcept: null, questionInstance: null };
  process.stdout.write(JSON.stringify({ total_cost_usd: Number(process.env.GRASP_QA_COST || "0.006"), result: JSON.stringify(result), is_error: false }));
  process.exit(0);
}
const result = {
  worthAsking: true,
  conceptTag: process.env.GRASP_QA_TAG || "input-validation",
  questionConcept: "Why should input validation happen at a trust boundary?",
  questionInstance: "Why does this diff reject an empty token before continuing?"
};
process.stdout.write(JSON.stringify({ total_cost_usd: Number(process.env.GRASP_QA_COST || "0.006"), result: JSON.stringify(result), is_error: false }));
