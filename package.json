{
  "name": "grasp-cli",
  "version": "0.1.0",
  "description": "A terminal-native CLI that generates comprehension questions about your AI coding agent's changes, answered on your own schedule in `grasp review` (with an optional hard gate on the agent's next action).",
  "license": "MIT",
  "type": "commonjs",
  "bin": {
    "grasp": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "pretest": "npm run build",
    "test": "tsc -p tsconfig.test.json && node --test test-dist/test/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.2",
    "ink": "^5.2.1",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.31",
    "typescript": "^5.7.2"
  }
}
