#!/usr/bin/env node
// A controllable stand-in for the real `claude` CLI, used by test/caps.test.ts
// to exercise runGeneration's cap/cost logic without a real Claude Code
// subscription. Behavior is selected via env vars, matching the pattern used
// throughout this project's manual verification (mock claude binaries on PATH).
const fs = require("fs");

const mode = process.env.GRASP_TEST_MOCK_MODE || "normal";

// Optional argv capture — used by generation.test.ts to assert exactly which
// isolation flags invokeClaudeJudge actually invoked `claude` with (a
// regression guard for the `--allowedTools ""` vs `--tools "" --safe-mode
// --setting-sources "" --strict-mcp-config` privacy bug an independent test
// pass found; see DECISIONS.md's "Generation call tool/context isolation
// flags" entry).
const argvLogPath = process.env.GRASP_TEST_MOCK_ARGV_LOG;
if (argvLogPath) {
  fs.writeFileSync(argvLogPath, JSON.stringify(process.argv.slice(2)));
}

// Optional artificial delay before responding, in ms — used by concurrency
// regression tests that need each mock call to stay "in flight" long enough
// for other racing processes to actually overlap it (see
// test/generationCapRace.test.ts). A real synchronous sleep (Atomics.wait),
// so it behaves like real generation latency rather than something this
// single-threaded script could race past.
const delayMs = parseInt(process.env.GRASP_TEST_MOCK_DELAY_MS || "0", 10);
if (delayMs > 0) {
  Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, delayMs);
}

if (mode === "error") {
  process.stdout.write(JSON.stringify({ total_cost_usd: 0.001, result: "", is_error: true }));
  process.exit(0);
}

if (mode === "bad-json-result") {
  // Envelope itself is well-formed and reports a real cost, but `result`
  // isn't the expected JSON contract — proves cost is still recorded on a
  // malformed-response miss (see DECISIONS.md's malformed-response entry).
  process.stdout.write(JSON.stringify({ total_cost_usd: 0.002, result: "not valid json at all", is_error: false }));
  process.exit(0);
}

if (mode === "brand-new-concept-no-question") {
  // Contract violation: worthAsking=true for a concept tag the caller has
  // never seen answered before, but questionConcept is null anyway — used
  // by test/generation.test.ts to prove Grasp enforces concept-first
  // deterministically rather than trusting the model's self-report.
  const result = {
    worthAsking: true,
    conceptTag: "brand-new-concept",
    questionConcept: null,
    questionInstance: "instance question with no concept question first",
    sampleAnswerConcept: null,
    sampleAnswerInstance: "sample answer for the instance question",
    conceptExplanation: "standalone explanation of the concept",
  };
  process.stdout.write(JSON.stringify({ total_cost_usd: 0.001, result: JSON.stringify(result), is_error: false }));
  process.exit(0);
}

if (mode === "invalid-tag-format") {
  const result = {
    worthAsking: true,
    conceptTag: "Not Kebab Case!",
    questionConcept: "concept q",
    questionInstance: "instance q",
  };
  process.stdout.write(JSON.stringify({ total_cost_usd: 0.001, result: JSON.stringify(result), is_error: false }));
  process.exit(0);
}

if (mode === "missing-cost") {
  // Counter is optional here (only caps.test.ts's cost-cap-focused test
  // above passes GRASP_TEST_MOCK_COUNTER) — used by the "repeated
  // unknown-cost failures must not keep invoking claude" regression test to
  // prove the mock is only ever actually invoked once per session, not once
  // per runGeneration call.
  const counterPath = process.env.GRASP_TEST_MOCK_COUNTER;
  if (counterPath) {
    let n = 0;
    try {
      n = parseInt(fs.readFileSync(counterPath, "utf-8"), 10) || 0;
    } catch {
      n = 0;
    }
    fs.writeFileSync(counterPath, String(n + 1));
  }
  const result = {
    worthAsking: true,
    conceptTag: "missing-cost-tag",
    questionConcept: "concept q",
    questionInstance: "instance q",
  };
  process.stdout.write(JSON.stringify({ result: JSON.stringify(result), is_error: false }));
  process.exit(0);
}

if (mode === "error-envelope-exit1") {
  // Claude Code's own "print a JSON result then exit nonzero" convention
  // for some error responses (its unauthenticated-error case, per the
  // independent test report) — the envelope itself is valid and reports a
  // real cost, but the process exits 1, which makes Node's execFileSync
  // throw instead of returning stdout normally. Used to prove
  // invokeClaudeJudge recovers the cost from the thrown error's own
  // `.stdout` instead of discarding it.
  process.stdout.write(JSON.stringify({ total_cost_usd: 0.001, result: "", is_error: true }));
  process.exit(1);
}

if (mode === "negative-cost") {
  // A malformed envelope reporting a negative cost — used by
  // test/caps.test.ts to prove a negative total_cost_usd can't manufacture
  // artificial room under the session cost cap.
  const result = {
    worthAsking: true,
    conceptTag: "negative-cost-tag",
    questionConcept: "concept q",
    questionInstance: "instance q",
  };
  process.stdout.write(JSON.stringify({ total_cost_usd: -0.5, result: JSON.stringify(result), is_error: false }));
  process.exit(0);
}

// mode === "normal": always worth asking, fresh concept tag per call (via a
// counter file) so memoization never suppresses the concept question.
const counterPath = process.env.GRASP_TEST_MOCK_COUNTER;
let n = 0;
if (counterPath) {
  try {
    n = parseInt(fs.readFileSync(counterPath, "utf-8"), 10) || 0;
  } catch {
    n = 0;
  }
  n += 1;
  fs.writeFileSync(counterPath, String(n));
}
const cost = process.env.GRASP_TEST_MOCK_COST ? parseFloat(process.env.GRASP_TEST_MOCK_COST) : 0.001;
const result = {
  worthAsking: true,
  conceptTag: `test-concept-${n}`,
  questionConcept: `concept question ${n}`,
  questionInstance: `instance question ${n}`,
  sampleAnswerConcept: `sample answer for concept ${n}`,
  sampleAnswerInstance: `sample answer for instance ${n}`,
  conceptExplanation: `explanation for concept ${n}`,
  // Only read by parseScanJudgeResponse (grasp scan's own contract) —
  // parseJudgeResponse (the diff contract) reads specific keys off the
  // parsed object and never rejects unknown extras, so including these
  // unconditionally is safe for every existing diff-side test too. A fixed
  // small range is fine here — computeValidatedExcerpt clamps it to
  // whatever the real file's line count actually is.
  citedLineStart: 1,
  citedLineEnd: 2,
};
process.stdout.write(JSON.stringify({ total_cost_usd: cost, result: JSON.stringify(result), is_error: false }));
